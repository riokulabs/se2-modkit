"""Build ${name}'s models with the se2-modkit pipeline, inside Blender:

    se2mod blender run Source/Model/${build_script}.py -- [BLOCK ...]

The blocks come from `${pkg}/catalog.py`, the pipeline tables from `${pkg}/hooks.py`.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

try:    # first: it records the files the build reads (even at import time), which incremental builds rely on
    import se2modkit.pipeline  # noqa: F401
except ImportError:
    pass

from ${pkg} import catalog, hooks  # noqa: E402


def main(argv: list[str] | None = None) -> int | None:
    try:
        from se2modkit.pipeline.runner import Runner, script_argv
    except ImportError:
        print("This se2-modkit has no model pipeline (se2modkit.pipeline.runner): install the se2-modkit version "
              "pyproject.toml pins, then run this script again.", file=sys.stderr)
        return 2
    runner = Runner(hooks=hooks.build_hooks(), builders=catalog.BUILDERS, catalogue=catalog.catalogue)
    return runner.launch(script_argv() if argv is None else argv)


if __name__ == "__main__":
    rc = main()
    if rc is not None:      # None: a windowed Blender runs the build from a timer and quits itself
        sys.exit(rc)
