# managed by riokulabs/.github - edit there (templates/), not here
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc,toml,md,mdx,ts,tsx,js,mjs,cjs,astro,css,html}]
indent_size = 2

# Trailing double space is a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[Makefile]
indent_style = tab
